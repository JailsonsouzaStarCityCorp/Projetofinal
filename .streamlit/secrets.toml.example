# Copie este arquivo para .streamlit/secrets.toml e preencha com os dados do Supabase
# (Project Settings > Database > Connection string). O secrets.toml está no .gitignore.
# No Streamlit Cloud, cole o mesmo conteúdo em: App > Settings > Secrets.

[connections.postgresql]
dialect = "postgresql"
host = "aws-0-sa-east-1.pooler.supabase.com"
port = 5432
database = "postgres"
username = "postgres.SEU_PROJECT_REF"
password = "SUA_SENHA_AQUI"
query = { sslmode = "require" }
